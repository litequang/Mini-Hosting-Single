{
  "name": "mini-hosting-single",
  "version": "2.1.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Independent Android Termux hosting using the original Panel 9090",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": "node panel/src/server.mjs",
    "setup": "node panel/tools/setup.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/check.mjs",
    "vendor": "node tools/build-vendor.mjs"
  },
  "license": "UNLICENSED",
  "overrides": {
    "minimatch": "11.0.1"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@noble/hashes": "2.4.0",
    "@tus/file-store": "2.1.1",
    "@tus/server": "2.4.6",
    "@uppy/core": "6.3.0",
    "@uppy/tus": "6.0.0",
    "archiver": "8.0.0",
    "busboy": "1.6.0",
    "cloudflare": "7.3.0",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "fastcgi-client": "0.2.0",
    "node-cron": "4.6.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
